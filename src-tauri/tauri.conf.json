{
    "productName": "ControlInventario",
    "version": "0.1.0",
    "identifier": "com.control.inventario",
    "build": {
        "beforeDevCommand": "npm run dev --prefix ui",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build --prefix ui",
        "frontendDist": "./ui/dist"
    },
    "app": {
        "windows": [
            {
                "title": "Control de Inventario",
                "width": 800,
                "height": 600
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/icon.png"]
    }
}